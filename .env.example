# Desarrollo local. Copiar como .env; nunca guardar credenciales en Git.
RN_DATABASE_URL=sqlite:///./data/rn-live.db
RN_STORAGE_DIR=data/media
RN_FFMPEG=ffmpeg
RN_FFPROBE=ffprobe
RN_WHISPER_MODEL=small
RN_WHISPER_DEVICE=cpu
RN_WHISPER_COMPUTE_TYPE=int8
RN_HF_TOKEN=
RN_INSTALL_AUDIO=false

# OpenRouter: opcional para pruebas del análisis; nunca exponer al frontend.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_FREE_ONLY=true
OPENROUTER_TIMEOUT_SECONDS=45
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=RN-live
